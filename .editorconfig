root = true


# === 基本書式 ===


[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120


# === ブレース ===


# --- ブレースは独立行（Allman） ---
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true


# --- if・ループ・using などは、早期リターンを含め、1文でも常にブロックにする ---
csharp_prefer_braces = true:warning
resharper_braces_for_ifelse = required
resharper_braces_for_for = required
resharper_braces_for_foreach = required
resharper_braces_for_while = required
resharper_braces_for_dowhile = required
resharper_braces_for_using = required
resharper_braces_for_lock = required
resharper_braces_for_fixed = required


# --- 1文だけのブロックも、ブレースを別々の行に置く ---
resharper_place_simple_embedded_block_on_same_line = false


# --- 空のブロックは、ブレースを別々の行に置く ---
resharper_empty_block_style = multiline


# === 改行・折り返し ===


# --- where は宣言の次の行に、1つずつ置く ---
resharper_place_type_constraints_on_same_line = false
resharper_wrap_before_first_type_parameter_constraint = true
resharper_wrap_multiple_type_parameter_constraints_style = chop_always


# --- 長い条件式は演算子ごとに改行し、演算子を行頭に置く（揃えずに通常の継続インデントにする） ---
resharper_wrap_before_binary_opsign = true
resharper_wrap_chained_binary_expressions = chop_if_long
resharper_align_multiline_binary_expressions_chain = false


# --- オブジェクト初期化子・匿名型・クエリ式は、要素ごとに改行する ---
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true


# --- フィールドの短い属性は同じ行、Tooltip などの長い属性と、型・メソッドの属性は別の行に置く ---
resharper_keep_existing_attribute_arrangement = false
resharper_place_field_attribute_on_same_line = true
resharper_place_type_attribute_on_same_line = false
resharper_place_method_attribute_on_same_line = false
resharper_max_attribute_length_for_same_line = 50


# === インデント・スペース ===


# --- switch の case とその中身はインデントする ---
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_switch_labels = true
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_labels = one_less_than_current


csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false


# === 空行（Rider） ===


# --- using の後、型の前後、メソッドの前後は2行 ---
resharper_blank_lines_after_using_list = 2
resharper_blank_lines_around_type = 2
resharper_blank_lines_around_single_line_type = 2
resharper_blank_lines_around_invocable = 2
resharper_blank_lines_around_single_line_invocable = 2


# --- namespace と型の中の先頭・末尾には空行を入れない ---
resharper_blank_lines_inside_namespace = 0
resharper_blank_lines_inside_type = 0


# --- フィールド・プロパティ・イベントは空行を強制しない（グループの詰めと2行の区切りは手で管理する） ---
resharper_blank_lines_around_field = 0
resharper_blank_lines_around_single_line_field = 0
resharper_blank_lines_around_property = 0
resharper_blank_lines_around_single_line_property = 0
resharper_blank_lines_around_auto_property = 0
resharper_blank_lines_around_single_line_auto_property = 0
resharper_keep_blank_lines_in_declarations = 2


# --- メソッド内の段落区切りは最大1行、ローカル関数の前後は1行 ---
resharper_keep_blank_lines_in_code = 1
resharper_blank_lines_around_local_method = 1


# === コメント ===


# --- XML ドキュメントコメントの中身はタグと同じ位置に揃える ---
resharper_xmldoc_indent_text = ZeroIndent
resharper_xmldoc_indent_child_elements = ZeroIndent


# === 構文スタイル ===


# --- namespace はブロック形式（Unity 6 は C# 9 のため） ---
csharp_style_namespace_declarations = block_scoped:warning


# --- using は namespace の外に置き、System を先頭にする ---
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false


# --- アクセス修飾子を省略しない（インターフェースのメンバーは除く） ---
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning


# --- 修飾子の並び順 ---
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion


# --- this. は付けない ---
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion


# --- 型名は int・string などの組み込み型のキーワードで書く ---
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion


# --- var は型が右辺から明らかなときだけ ---
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion


# --- 型が明らかなときは new() で生成する ---
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion


# --- プロパティ・インデクサ・アクセサ・ラムダは式形式、メソッド・コンストラクタ・演算子・ローカル関数はブロック形式 ---
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_local_functions = false:suggestion


# --- 変更しないフィールドは readonly にする ---
dotnet_style_readonly_field = true:suggestion


# --- パターンマッチング・switch 式などの新しい構文を優先する ---
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion


# --- null チェックは ?. や ?? を優先する ---
# UnityEngine.Object には使えない（破棄済みの判定がされない）。Rider は Unity のオブジェクトにはこの提案をしない。
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_throw_expression = true:suggestion


# --- 演算子の優先順位がわかりにくい箇所は括弧を付ける ---
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent


# --- 複数行のリストは最後の要素にもカンマを付ける ---
resharper_trailing_comma_in_multiline_lists = true


# === 命名スタイル ===


# --- PascalCase ---
dotnet_naming_style.pascal_case.capitalization = pascal_case


# --- camelCase ---
dotnet_naming_style.camel_case.capitalization = camel_case


# --- _camelCase ---
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _


# --- s_camelCase ---
dotnet_naming_style.s_camel_case.capitalization = camel_case
dotnet_naming_style.s_camel_case.required_prefix = s_


# --- IPascalCase ---
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I


# --- TPascalCase ---
dotnet_naming_style.t_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_pascal_case.required_prefix = T


# === 命名規則 ===


# --- const フィールドは PascalCase ---
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.const_fields.required_modifiers = const

dotnet_naming_rule.const_fields_rule.symbols = const_fields
dotnet_naming_rule.const_fields_rule.style = pascal_case
dotnet_naming_rule.const_fields_rule.severity = warning


# --- private const フィールドは PascalCase（private static ルールとの重なりを解消する） ---
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

dotnet_naming_rule.private_const_fields_rule.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_rule.style = pascal_case
dotnet_naming_rule.private_const_fields_rule.severity = warning


# --- private static フィールドは s_camelCase ---
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_rule.private_static_fields_rule.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_rule.style = s_camel_case
dotnet_naming_rule.private_static_fields_rule.severity = warning


# --- private 以外の static フィールドは PascalCase ---
dotnet_naming_symbols.non_private_static_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_static_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.non_private_static_fields.required_modifiers = static

dotnet_naming_rule.non_private_static_fields_rule.symbols = non_private_static_fields
dotnet_naming_rule.non_private_static_fields_rule.style = pascal_case
dotnet_naming_rule.non_private_static_fields_rule.severity = warning


# --- private インスタンスフィールドは _camelCase ---
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_rule.private_instance_fields_rule.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_rule.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_rule.severity = warning


# --- private 以外のインスタンスフィールドは PascalCase ---
dotnet_naming_symbols.non_private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_instance_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_rule.non_private_instance_fields_rule.symbols = non_private_instance_fields
dotnet_naming_rule.non_private_instance_fields_rule.style = pascal_case
dotnet_naming_rule.non_private_instance_fields_rule.severity = warning


# --- 型・メソッド・プロパティ・イベント・ローカル関数は PascalCase ---
dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, property, event, local_function
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

dotnet_naming_rule.types_and_members_rule.symbols = types_and_members
dotnet_naming_rule.types_and_members_rule.style = pascal_case
dotnet_naming_rule.types_and_members_rule.severity = warning


# --- インターフェースは IPascalCase ---
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_rule.interfaces_rule.symbols = interfaces
dotnet_naming_rule.interfaces_rule.style = i_pascal_case
dotnet_naming_rule.interfaces_rule.severity = warning


# --- ジェネリックの型引数は TPascalCase ---
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_rule.type_parameters_rule.symbols = type_parameters
dotnet_naming_rule.type_parameters_rule.style = t_pascal_case
dotnet_naming_rule.type_parameters_rule.severity = warning


# --- ローカル変数・引数は camelCase ---
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_rule.locals_and_parameters_rule.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_rule.style = camel_case
dotnet_naming_rule.locals_and_parameters_rule.severity = warning


# === Unity のアセット定義 ===


# --- asmdef・asmref は、Unity が書き出す形式（スペース4つ）に合わせる ---
[*.{asmdef,asmref}]
indent_style = space
indent_size = 4


# --- package.json などの JSON は、UPM で一般的なスペース2つにする ---
[*.json]
indent_style = space
indent_size = 2
